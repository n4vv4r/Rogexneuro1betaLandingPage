# ───────── Agente de chat de Rogex ─────────
# Copia este archivo como `.env` (local) y configura las mismas variables en tu host
# (Vercel: Project Settings → Environment Variables; Cloudflare: Settings → Variables).
# NUNCA subas el .env real al repositorio.

# Obligatorio: tu API key de Anthropic (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Opcional: modelo. Por defecto, un modelo ligero y barato para chat de alto volumen.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Seguridad: limita quién puede llamar al endpoint (protege tu factura de API).
# Pon el dominio de tu web, p. ej. https://rogexlaboratories.com
ALLOWED_ORIGIN=

# Compra: YA está fijado en src/config.ts (BUY_URL). Rellena esto solo si quieres SOBREESCRIBIRLO.
buyUrl=

# Agenda: enlace de Cal.com o Calendly para llamadas con inversores.
BOOKING_URL=

# Leads: webhook de Make que recibe los contactos capturados por el agente.
LEAD_WEBHOOK_URL=

# Opcional: enlace al investor brief, si ya existe.
investorBriefUrl=
