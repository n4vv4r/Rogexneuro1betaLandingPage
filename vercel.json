        { "key": "Content-Disposition", "value": "attachment; filename=prisma-engine-0.1.0-x86_64-linux.sha256" }
      ]
    },
    {
      "source": "/downloads/PRISMA-Engine-0.1.0-Setup.exe",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=PRISMA-Engine-0.1.0-Setup.exe" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
