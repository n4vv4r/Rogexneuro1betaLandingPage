{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "newspaper.rogexlaboratories.com" }],
      "destination": "/newspaper.html"
    },
    { "source": "/newspaper", "destination": "/newspaper-path.html" },
    { "source": "/newspaper/", "destination": "/newspaper-path.html" },
    { "source": "/newspaper/:slug", "destination": "/newspaper-path.html" },
    { "source": "/suite", "destination": "/suite.html" },
    { "source": "/architecture", "destination": "/architecture.html" },
    { "source": "/prisma", "destination": "/prisma.html" },
    { "source": "/navi", "destination": "/navi.html" },
    { "source": "/navi/", "destination": "/navi.html" },
    { "source": "/roadmap", "destination": "/roadmap.html" },
    { "source": "/roadmap/", "destination": "/roadmap.html" },
    { "source": "/downloads", "destination": "/downloads.html" },
    { "source": "/docs", "destination": "/docs.html" },
    { "source": "/docs/", "destination": "/docs.html" },
    { "source": "/docs/eternal-eclipse", "destination": "/docs-eternal-eclipse.html" },
    { "source": "/docs/eternal-eclipse/", "destination": "/docs-eternal-eclipse.html" },
    { "source": "/docs/resumen-tecnico", "destination": "/docs-resumen-tecnico.html" },
    { "source": "/docs/resumen-tecnico/", "destination": "/docs-resumen-tecnico.html" },
    { "source": "/docs/navi7", "destination": "/docs-navi7.html" },
    { "source": "/docs/navi7/", "destination": "/docs-navi7.html" },
    { "source": "/docs/navi66", "destination": "/docs-navi66.html" },
    { "source": "/docs/navi66/", "destination": "/docs-navi66.html" },
    { "source": "/docs/isos", "destination": "/docs-isos.html" },
    { "source": "/docs/isos/", "destination": "/docs-isos.html" },
    { "source": "/docs/navi10", "destination": "/docs-navi10.html" },
    { "source": "/docs/navi10/", "destination": "/docs-navi10.html" },
    { "source": "/docs/rxos10", "destination": "/docs-rxos10.html" },
    { "source": "/docs/rxos10/", "destination": "/docs-rxos10.html" },
    { "source": "/docs/navi10-spec", "destination": "/docs-navi10-spec.html" },
    { "source": "/docs/navi10-spec/", "destination": "/docs-navi10-spec.html" },
    { "source": "/docs/:id", "destination": "/docs.html" },
    { "source": "/rx-os", "destination": "/rx-os.html" },
    { "source": "/rx-os/", "destination": "/rx-os.html" },
    { "source": "/rx-os/packages", "destination": "/rx-os-packages.html" },
    { "source": "/rx-os/packages/", "destination": "/rx-os-packages.html" },
    {
      "source": "/rx-os/packages/:name.rxc",
      "destination": "/api/rxos/packages/serve?name=:name.rxc"
    },
    { "source": "/rogexos", "destination": "/rx-os.html" },
    { "source": "/investors", "destination": "/investors.html" },
    { "source": "/pitch", "destination": "/pitch.html" },
    { "source": "/startup-idea", "destination": "/startup-idea.html" },
    { "source": "/about", "destination": "/about.html" }
  ],
  "headers": [
    {
      "source": "/downloads/RXos-v4.1.1.zip",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=RXos-v4.1.1.zip" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloads/RXos-v4.1.1.zip.sha256",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=RXos-v4.1.1.zip.sha256" }
      ]
    },
    {
      "source": "/downloads/prisma-engine-0.1.0-x86_64-linux.tar.gz",
